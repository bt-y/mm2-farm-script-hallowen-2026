    if IJ and lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

lp.CharacterAdded:Connect(function(ch)
    task.wait(0.4)
    local hum = ch:FindFirstChild("Humanoid")
    if hum then
        hum.JumpPower = JP
    end
end)

local coinRemote = RPS:FindFirstChild("Remotes")
if coinRemote then
    coinRemote = coinRemote:FindFirstChild("Gameplay")
    if coinRemote then coinRemote = coinRemote:FindFirstChild("CoinCollected") end
end
if coinRemote then
    coinRemote.OnClientEvent:Connect(function(_, cur, max)
        if cur >= max and RF and lp.Character then
            if getRole(lp) == "Murderer" then
                sw("🔪 **Murderer full** - **" .. lp.Name .. "** resetting", false)
            end
            lp.Character:BreakJoints()
        end
    end)
end

-- ==================== FARM LOOP (Safe mode fixed) ====================
task.spawn(function()
    while true do
        if AF then
            local ch = lp.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChild("Humanoid")
            if root and hum then
                local murd = getMurderer()
                local murdRoot = murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart")

                if MODE == "Safe" then
                    hum.PlatformStand = true
                    hum.Sit = false
                    hum.AutoRotate = false
                    root.CFrame = CFrame.new(root.Position) * CFrame.Angles(math.rad(-90), 0, 0)

                    local closest, dist = nil, math.huge
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Name == "Coin_Server" and not VS[obj] then
                            local d = (obj.Position - root.Position).Magnitude
                            if d < dist and d < 25 then
                                closest = obj
                                dist = d
                            end
                        end
                    end

                    if closest then
                        local under = closest.Position - Vector3.new(0, 2.5, 0)
                        root.CFrame = CFrame.new(under) * CFrame.Angles(math.rad(-90), 0, 0)
                        task.wait(0.25)
                        VS[closest] = true
                        CL = CL + 1
                        LT = tick()
                        IS = false
                    end
                    task.wait(0.35)
                else
                    hum.PlatformStand = false
                    hum.AutoRotate = true

                    local closest, dist = nil, math.huge
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Name == "Coin_Server" and not VS[obj] then
                            local d = (obj.Position - root.Position).Magnitude
                            if d < dist and d < RG then
                                if MODE == "Strategy" and murdRoot then
                                    local md = (obj.Position - murdRoot.Position).Magnitude
                                    if md >= 45 then
                                        closest = obj
                                        dist = d
                                    end
                                else
                                    closest = obj
                                    dist = d
                                end
                            end
                        end
                    end

                    if closest then
                        local tw = TS:Create(root, TweenInfo.new(dist / SP, Enum.EasingStyle.Linear), {
                            CFrame = CFrame.new(closest.Position)
                        })
                        tw:Play()
                        tw.Completed:Wait()
                        if closest and closest.Parent then
                            VS[closest] = true
                            CL = CL + 1
                            LT = tick()
                            IS = false
                        end
                    end
                    task.wait(0.08)
                end
            else
                task.wait(0.5)
            end
        else
            local ch = lp.Character
            local hum = ch and ch:FindFirstChild("Humanoid")
            if hum then
                hum.PlatformStand = false
                hum.AutoRotate = true
            end
            task.wait(0.5)
        end
    end
end)

lp.Idled:Connect(function()
    if AK then
        VU:Button2Down(Vector2.new(), workspace.CurrentCamera.CFrame)
        task.wait(1)
        VU:Button2Up(Vector2.new(), workspace.CurrentCamera.CFrame)
    end
end)

RS.Stepped:Connect(function()
    if AF and lp.Character and MODE ~= "Safe" then
        for _, p in ipairs(lp.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

