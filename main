    local t1 = mkToggle("Inf Jump", content, IJ, function(v) IJ = v end)
    t1.LayoutOrder = 1

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -18, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Text = "JumpPower: " .. JP
    lbl.TextColor3 = Color3.fromRGB(190, 170, 220)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.LayoutOrder = 2
    lbl.Parent = content

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -18, 0, 32)
    box.BackgroundColor3 = Color3.fromRGB(35, 22, 50)
    box.Text = tostring(JP)
    box.TextColor3 = Color3.new(1,1,1)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 14
    box.LayoutOrder = 3
    box.Parent = content
