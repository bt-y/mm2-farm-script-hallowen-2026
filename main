    box2.Size = UDim2.new(1, -18, 0, 32)
    box2.BackgroundColor3 = Color3.fromRGB(35, 22, 50)
    box2.Text = tostring(SP)
    box2.TextColor3 = Color3.new(1,1,1)
    box2.Font = Enum.Font.GothamBold
    box2.TextSize = 14
    box2.LayoutOrder = 5
    box2.Parent = content
    Instance.new("UICorner", box2).CornerRadius = UDim.new(0, 6)
    box2.FocusLost:Connect(function(e)
        if e then
            local n = tonumber(box2.Text)
            SP = n and math.clamp(n, 1, 500) or SP
