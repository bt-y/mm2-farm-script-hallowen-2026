local function mkBtn(txt, y, parent, col)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -14, 0, 34)
    b.Position = UDim2.new(0, 7, 0, y)
    b.BackgroundColor3 = col or Color3.fromRGB(45, 30, 65)
    b.Text = txt
    b.TextColor3 = Color3.fromRGB(230, 200, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
    return b
end

local function mkToggle(txt, parent, state, cb)
    local st = state
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -18, 0, 36)
    b.BackgroundColor3 = st and Color3.fromRGB(90, 40, 160) or Color3.fromRGB(40, 28, 55)
    b.Text = txt .. (st and "  : ON" or "  : OFF")
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 13
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 7)
    b.MouseButton1Click:Connect(function()
        st = not st
        b.Text = txt .. (st and "  : ON" or "  : OFF")
        b.BackgroundColor3 = st and Color3.fromRGB(90, 40, 160) or Color3.fromRGB(40, 28, 55)
        cb(st)
    end)
    return b
end

local function showAF()
    clearContent()
    content.CanvasSize = UDim2.new(0, 0, 0, 460)

    local t1 = mkToggle("AutoFarm", content, AF, function(v)
        AF = v
        if v then
            CL = 0
            VS = {}
            LT = tick()
            IS = false
            sw("🟢 AutoFarm **ON** by **" .. lp.Name .. "**", false)
        else
            sw("🔴 AutoFarm **OFF** by **" .. lp.Name .. "**", false)
        end
    end)
    t1.LayoutOrder = 1

    local t2 = mkToggle("Anti AFK", content, AK, function(v) AK = v end)
    t2.LayoutOrder = 2

    local t3 = mkToggle("Reset on Full", content, RF, function(v) RF = v end)
    t3.LayoutOrder = 3

    local t4 = mkToggle("Performance", content, PM, function(v)
        if v and not PM then epm() end
    end)
    t4.LayoutOrder = 4

    local modeLbl = Instance.new("TextLabel")
    modeLbl.Size = UDim2.new(1, -18, 0, 22)
    modeLbl.BackgroundTransparency = 1
    modeLbl.Text = "Farm Mode: " .. MODE
    modeLbl.TextColor3 = Color3.fromRGB(200, 170, 255)
    modeLbl.Font = Enum.Font.GothamBold
    modeLbl.TextSize = 13
    modeLbl.LayoutOrder = 5
    modeLbl.Parent = content

    local modes = {"Safe", "Normal", "Strategy"}
    for i, m in ipairs(modes) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -18, 0, 30)
        b.BackgroundColor3 = (MODE == m) and Color3.fromRGB(110, 50, 180) or Color3.fromRGB(40, 28, 55)
        b.Text = m
        b.TextColor3 = Color3.new(1,1,1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 13
        b.LayoutOrder = 5 + i
        b.Parent = content
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        b.MouseButton1Click:Connect(function()
            MODE = m
            modeLbl.Text = "Farm Mode: " .. MODE
            for _, c in ipairs(content:GetChildren()) do
                if c:IsA("TextButton") and (c.Text == "Safe" or c.Text == "Normal" or c.Text == "Strategy") then
                    c.BackgroundColor3 = (c.Text == MODE) and Color3.fromRGB(110, 50, 180) or Color3.fromRGB(40, 28, 55)
                end
            end
            sw("Farm Mode set to **" .. MODE .. "** by **" .. lp.Name .. "**", false)
        end)
    end

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -18, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Text = "Farm Speed: " .. SP
    lbl.TextColor3 = Color3.fromRGB(190, 170, 220)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 13
    lbl.LayoutOrder = 10
    lbl.Parent = content

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -18, 0, 32)
    box.BackgroundColor3 = Color3.fromRGB(35, 22, 50)
    box.Text = tostring(SP)
    box.TextColor3 = Color3.new(1,1,1)
    box.Font = Enum.Font.GothamBold
    box.TextSize = 14
    box.LayoutOrder = 11
    box.Parent = content
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
    box.FocusLost:Connect(function(e)
        if e then
            local n = tonumber(box.Text)
            SP = n and math.clamp(n, 1, 500) or SP
            box.Text = tostring(SP)
            lbl.Text = "Farm Speed: " .. SP
        end
    end)

    local cnt = Instance.new("TextLabel")
    cnt.Size = UDim2.new(1, -18, 0, 24)
    cnt.BackgroundTransparency = 1
    cnt.Text = "Collected: 0"
    cnt.TextColor3 = Color3.fromRGB(210, 180, 255)
    cnt.Font = Enum.Font.Gotham
    cnt.TextSize = 14
    cnt.LayoutOrder = 12
    cnt.Parent = content
    task.spawn(function()
        while cnt and cnt.Parent do
            cnt.Text = "Collected: " .. CL
            task.wait(0.4)
        end
    end)
end

local function showESP()
    clearContent()
    content.CanvasSize = UDim2.new(0, 0, 0, 180)
    local t = mkToggle("Role ESP", content, ES, function(v)
        ES = v
        if not v then
            for _, h in pairs(HL) do
                if h then pcall(function() h:Destroy() end) end
            end
            HL = {}
        end
    end)
    t.LayoutOrder = 1

    local info = Instance.new("TextLabel")
    info.Size = UDim2.new(1, -18, 0, 80)
    info.BackgroundTransparency = 1
    info.Text = "Murderer  =  Red\nSheriff   =  Blue\nInnocent =  Green"
    info.TextColor3 = Color3.fromRGB(190, 170, 230)
    info.Font = Enum.Font.Gotham
    info.TextSize = 14
    info.TextYAlignment = Enum.TextYAlignment.Top
    info.LayoutOrder = 2
    info.Parent = content
end

