    {name = "AutoFarm", fn = showAF},
    {name = "ESP", fn = showESP},
    {name = "Movement", fn = showMove}
}

for i, tab in ipairs(tabs) do
    local b = mkBtn(tab.name, (i-1)*40 + 10, side, Color3.fromRGB(50, 30, 75))
    b.MouseButton1Click:Connect(function()
        for _, c in ipairs(side:GetChildren()) do
            if c:IsA("TextButton") then
                c.BackgroundColor3 = Color3.fromRGB(50, 30, 75)
            end
        end
        b.BackgroundColor3 = Color3.fromRGB(120, 60, 200)
        tab.fn()
    end)
end

showAF()
local first = side:FindFirstChildOfClass("TextButton")
if first then first.BackgroundColor3 = Color3.fromRGB(120, 60, 200) end

UIS.JumpRequest:Connect(function()
    if IJ and lp.Character and lp.Character:FindFirstChild("Humanoid") then
        lp.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

lp.CharacterAdded:Connect(function(ch)
    task.wait(0.4)
    local hum = ch:FindFirstChild("Humanoid")
    if hum then
        hum.JumpPower = JP
    end
end)

local coinRemote = RPS:FindFirstChild("Remotes")
if coinRemote then
    coinRemote = coinRemote:FindFirstChild("Gameplay")
    if coinRemote then coinRemote = coinRemote:FindFirstChild("CoinCollected") end
end
if coinRemote then
    coinRemote.OnClientEvent:Connect(function(_, cur, max)
        if cur >= max and RF and lp.Character then
            if getRole(lp) == "Murderer" then
                sw("🔪 **Murderer full** - **" .. lp.Name .. "** is resetting after clearing", false)
            end
            lp.Character:BreakJoints()
        end
    end)
end

task.spawn(function()
    while true do
        if AF then
            local ch = lp.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            if root then
                local murd = getMurderer()
                local murdRoot = murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart")

                if MODE == "Safe" then
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Name == "Coin_Server" and not VS[obj] then
                            local d = (obj.Position - root.Position).Magnitude
                            if d < 12 then
                                VS[obj] = true
                                CL = CL + 1
                                LT = tick()
                                IS = false
                            end
                        end
                    end
                    if ch:FindFirstChild("Humanoid") then
                        ch.Humanoid.Sit = true
                    end
                    task.wait(0.4)
                else
                    local closest, dist = nil, math.huge
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("BasePart") and obj.Name == "Coin_Server" and not VS[obj] then
                            local d = (obj.Position - root.Position).Magnitude
                            if d < dist and d < RG then
                                if MODE == "Strategy" and murdRoot then
                                    local md = (obj.Position - murdRoot.Position).Magnitude
                                    if md >= 45 then
                                        closest = obj
                                        dist = d
                                    end
                                else
                                    closest = obj
                                    dist = d
                                end
                            end
                        end
                    end

                    if closest then
                        if ch:FindFirstChild("Humanoid") then
                            ch.Humanoid.Sit = false
                        end
                        local tw = TS:Create(root, TweenInfo.new(dist / SP, Enum.EasingStyle.Linear), {
                            CFrame = CFrame.new(closest.Position)
                        })
                        tw:Play()
                        tw.Completed:Wait()
                        if closest and closest.Parent then
                            VS[closest] = true
                            CL = CL + 1
                            LT = tick()
                            IS = false
                        end
                    end
                    task.wait(0.08)
                end
            else
                task.wait(0.5)
            end
        else
            task.wait(0.5)
        end
    end
end)

lp.Idled:Connect(function()
    if AK then
        VU:Button2Down(Vector2.new(), workspace.CurrentCamera.CFrame)
        task.wait(1)
        VU:Button2Up(Vector2.new(), workspace.CurrentCamera.CFrame)
    end
end)

RS.Stepped:Connect(function()
    if AF and lp.Character and MODE ~= "Safe" then
        for _, p in ipairs(lp.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

print("[Hub] Loaded successfully")
