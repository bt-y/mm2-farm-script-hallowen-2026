local function setNoclip(on)
    local ch = lp.Character
    if not ch then return end
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = not on end
    end
end

local function epm()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        LG.GlobalShadows = false
        LG.FogEnd = 9e9
        LG.Brightness = 2
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam")
                or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                pcall(function() v.Enabled = false end)
            end
            if v:IsA("MeshPart") then
                local keep = v:IsDescendantOf(lp.Character) or v.Name == "Coin_Server"
                if not keep and v.Size.Magnitude > 8 then
                    pcall(function() v.Transparency = 1 v.CanCollide = false end)
                end
            end
            if v:IsA("PointLight") or v:IsA("SpotLight") or v:IsA("SurfaceLight") then
                pcall(function() v.Enabled = false end)
            end
        end
    end)
    PM = true
end

local function setNoRender(on)
    NORENDER = on
    pcall(function()
        if on then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            LG.FogEnd = 0
            LG.Brightness = 0
            workspace.CurrentCamera.FieldOfView = 1
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") and not v:IsDescendantOf(lp.Character) then
                    v.LocalTransparencyModifier = 1
                end
            end
        else
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            LG.FogEnd = 100000
            LG.Brightness = 1
            workspace.CurrentCamera.FieldOfView = 70
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("BasePart") then v.LocalTransparencyModifier = 0 end
            end
        end
    end)
end

local function getRole(pl)
    local ok, roles = pcall(function()
        local r = RPS:FindFirstChild("GetPlayerData", true)
        if r then return r:InvokeServer() end
    end)
    if ok and roles and roles[pl.Name] then
        return roles[pl.Name].Role or "Innocent"
    end
    local ch = pl.Character
    if ch then
        if ch:FindFirstChild("Knife") or (pl.Backpack and pl.Backpack:FindFirstChild("Knife")) then return "Murderer" end
        if ch:FindFirstChild("Gun") or (pl.Backpack and pl.Backpack:FindFirstChild("Gun")) then return "Sheriff" end
    end
    return "Innocent"
end

local function getMurderer()
    for _, pl in ipairs(P:GetPlayers()) do
        if getRole(pl) == "Murderer" then return pl end
    end
end

-- =========================================================
-- (LISTED DONE + FLING MURDER)
-- =========================================================
local function markListedDone(name)
    if WL[name] then
        listedDone[name] = true
    end
end

local function listedInServer()
    local t = {}
    for _, pl in ipairs(P:GetPlayers()) do
        if WL[pl.Name] then
            table.insert(t, pl)
        end
    end
    return t
end

local function allListedDone()
    local inSrv = listedInServer()
    if #inSrv == 0 then return false end
    for _, pl in ipairs(inSrv) do
        if not listedDone[pl.Name] then
            return false
        end
    end
    return true
end

local function clearListedDone()
    listedDone = {}
end

local function flingMurder()
    if flinging then return end
    if tick() - lastFling < 8 then return end
    local murd = getMurderer()
    if not murd then return end
    if WL[murd.Name] then
        print("[Fling] Murder is listed - ignored")
        return
    end
    local mChar = murd.Character
    local mRoot = mChar and mChar:FindFirstChild("HumanoidRootPart")
    local ch = lp.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    local hum = ch and ch:FindFirstChild("Humanoid")
    if not mRoot or not root or not hum then return end

    flinging = true
    lastFling = tick()
    print("[Fling] All listed done - flinging", murd.Name)
    sw("💀 **Fling** started by **" .. lp.Name .. "** → target **" .. murd.Name .. "**", false)

    task.spawn(function()
        setNoclip(true)
        local t0 = tick()
        while tick() - t0 < 3.5 do
            if not mRoot or not mRoot.Parent then break end
            if not root or not root.Parent then break end
            root.Anchored = false
            hum.PlatformStand = true
            root.CFrame = mRoot.CFrame * CFrame.new(0, 0, 1)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(9e3, 9e3, 9e3)
            task.wait(0.05)
        end
        if root and root.Parent then
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        if hum and hum.Parent then
            hum.PlatformStand = false
        end
        flinging = false
        clearListedDone()
        print("[Fling] Done")
    end)
end

local function tryFlingIfReady()
    if not allListedDone() then return end
    flingMurder()
end

-- Track deaths of listed players as "done"
local function hookChar(pl)
    if not WL[pl.Name] then return end
    local function onChar(ch)
        local hum = ch:WaitForChild("Humanoid", 5)
        if not hum then return end
        hum.Died:Connect(function()
            markListedDone(pl.Name)
            print("[Done]", pl.Name, "died/finished")
            tryFlingIfReady()
        end)
    end
    if pl.Character then onChar(pl.Character) end
    pl.CharacterAdded:Connect(onChar)
end

for _, pl in ipairs(P:GetPlayers()) do
    hookChar(pl)
end
P.PlayerAdded:Connect(hookChar)

-- Poll dead / missing character listed users
task.spawn(function()
    while true do
        task.wait(1.5)
        for _, pl in ipairs(listedInServer()) do
            local ch = pl.Character
            local hum = ch and ch:FindFirstChild("Humanoid")
            if not ch or not hum or hum.Health <= 0 then
                markListedDone(pl.Name)
            end
        end
        tryFlingIfReady()
    end
end)

local function removeAllDecals()
    local n = 0
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Decal") or v:IsA("Texture") then
            pcall(function() v:Destroy() end)
            n = n + 1
        end
    end
    print("[Decals] Removed", n)
end

-- Cached coin list
local coinCache = {}
local function isLiveCoin(obj)
    if not obj or not obj.Parent or not obj:IsA("BasePart") then return false end
    if VS[obj] then return false end
    -- MM2 always names map coins Coin_Server
    if obj.Name ~= "Coin_Server" then return false end
    if obj.Transparency >= 1 then return false end
    return true
end

local function rebuildCoinCache()
    coinCache = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isLiveCoin(obj) then
            table.insert(coinCache, obj)
        end
    end
    return #coinCache
end

workspace.DescendantAdded:Connect(function(obj)
    task.defer(function()
        if obj:IsA("BasePart") and isLiveCoin(obj) then
            table.insert(coinCache, obj)
        end
    end)
end)

task.spawn(function()
    task.wait(0.5)
    print("[Farm] Initial coins cached:", rebuildCoinCache())
    while true do
        task.wait(3)
        rebuildCoinCache()
    end
end)

local function getCoins()
    local list = {}
    local seen = {}
    for i = #coinCache, 1, -1 do
        local obj = coinCache[i]
        if isLiveCoin(obj) and not seen[obj] then
            seen[obj] = true
            table.insert(list, obj)
        else
            table.remove(coinCache, i)
        end
    end
    if #list == 0 then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if isLiveCoin(obj) and not seen[obj] then
                seen[obj] = true
                table.insert(list, obj)
                table.insert(coinCache, obj)
            end
        end
    end
    return list
end

-- Real bag count from server events / GUI
local realCoins = 0
local realMax = 40
local function readCoinGui()
    pcall(function()
        for _, g in ipairs(pg:GetDescendants()) do
            if g:IsA("TextLabel") or g:IsA("TextButton") then
                local t = g.Text or ""
                local a, b = string.match(t, "(%d+)%s*/%s*(%d+)")
                if a and b then
                    local cur, mx = tonumber(a), tonumber(b)
                    if cur and mx and mx >= 10 and mx <= 80 then
                        realCoins = cur
                        realMax = mx
                        return
                    end
                end
            end
        end
    end)
end

-- Safe move: duration = distance/speed (open-source MM2 style, less invalid position)
local function safeMoveTo(root, targetPos, speed)
    if not root or not root.Parent then return false end
    speed = math.clamp(speed or 16, 10, 26)
    local startPos = root.Position
    local dist = (targetPos - startPos).Magnitude
    if dist < 2.5 then
        root.CFrame = CFrame.new(targetPos)
        return true
    end
    local duration = math.clamp(dist / speed, 0.2, 10)
    local t0 = tick()
    while root and root.Parent do
        local alpha = math.min((tick() - t0) / duration, 1)
        root.CFrame = CFrame.new(startPos:Lerp(targetPos, alpha))
        root.AssemblyLinearVelocity = Vector3.zero
        if alpha >= 1 then return true end
        task.wait()
    end
    return false
end

local function touchCoin(coin, root)
    if not coin or not coin.Parent or not root then return end
    pcall(function()
        if firetouchinterest then
            firetouchinterest(root, coin, 0)
            task.wait(0.04)
            firetouchinterest(root, coin, 1)
        end
    end)
end

local function getPing()
    local ok, ping = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and typeof(ping) == "number" then return ping end
    return 0
end

local function updESP()
    if not ES then
        for _, h in pairs(HL) do if h then pcall(function() h:Destroy() end) end end
        HL = {}
        return
    end
    for _, pl in ipairs(P:GetPlayers()) do
        if pl ~= lp and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
            local role = getRole(pl)
            local col = Color3.fromRGB(40, 255, 80)
            if role == "Murderer" then col = Color3.fromRGB(255, 40, 40)
            elseif role == "Sheriff" or role == "Hero" then col = Color3.fromRGB(40, 120, 255) end
            local h = HL[pl]
            if not h or not h.Parent then
                h = Instance.new("Highlight")
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 0.45
                h.OutlineTransparency = 0.2
                h.Parent = pl.Character
                HL[pl] = h
            end
            h.FillColor = col
            h.OutlineColor = col
            h.Adornee = pl.Character
        end
    end
end

task.spawn(function()
    while true do
        task.wait(1)
        pcall(updESP)
    end
end)

