    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(1, 0, 0, 30)
    t.BackgroundTransparency = 1
    t.Text = "Enter Password"
    t.TextColor3 = Color3.fromRGB(200, 150, 255)
    t.Font = Enum.Font.GothamBold
    t.TextSize = 16
    t.Parent = f

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -30, 0, 32)
    box.Position = UDim2.new(0, 15, 0, 45)
    box.BackgroundColor3 = Color3.fromRGB(35, 20, 50)
    box.Text = ""
    box.PlaceholderText = "Password..."
    box.TextColor3 = Color3.new(1,1,1)
    box.Font = Enum.Font.Gotham
    box.TextSize = 14
    box.Parent = f
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -30, 0, 32)
    btn.Position = UDim2.new(0, 15, 0, 90)
    btn.BackgroundColor3 = Color3.fromRGB(120, 50, 180)
    btn.Text = "Unlock"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = f
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local done = false
    btn.MouseButton1Click:Connect(function()
        if box.Text == PASS then
            allowed = true
            done = true
            sg:Destroy()
        else
            box.Text = ""
            box.PlaceholderText = "Wrong password"
        end
    end)

    repeat task.wait(0.2) until done or not sg.Parent
    if not allowed then
        print("[Hub] Access denied")
        return
    end
end

local function sw(msg, ping)
    local c = ping and "@everyone\n" .. msg or msg
    local d = {content = c, username = "67skibidi Hub"}
    pcall(function()
        if request then
            request({
                Url = WU,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HS:JSONEncode(d)
            })
        end
    end)
end

-- Startup message
task.spawn(function()
    task.wait(1.2)
    sw("✅ **Script executed** by **" .. lp.Name .. "**", false)
end)

-- Whitelist leave
P.PlayerRemoving:Connect(function(pl)
    if WL[pl.Name] then
        sw("⚠️ **WHITELIST LEFT**\nPlayer: **" .. pl.Name .. "** disconnected / kicked", true)
    end
end)

-- Whitelist join
P.PlayerAdded:Connect(function(pl)
    if WL[pl.Name] then
        task.wait(1)
        sw("🟢 **WHITELIST JOINED**\nPlayer: **" .. pl.Name .. "** joined the server", false)
    end
end)

local AF = false
local SP = 50
local RG = 300
local VS = {}
local CL = 0
local AK = false
local RF = true
local LT = tick()
local IS = false
local PM = false
local IJ = false
local JP = 50
local ES = false
local HL = {}
local MODE = "Normal"
local MU = false

local function epm()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        LG.GlobalShadows = false
        LG.FogEnd = 9e9
        LG.Brightness = 2
    end)
    PM = true
end

local function getRole(pl)
    local ok, roles = pcall(function()
        local r = RPS:FindFirstChild("GetPlayerData", true)
        if r then return r:InvokeServer() end
        return nil
    end)
    if ok and roles and roles[pl.Name] then
        return roles[pl.Name].Role or "Innocent"
    end
    local ch = pl.Character
    if ch then
        if ch:FindFirstChild("Knife") or (pl.Backpack and pl.Backpack:FindFirstChild("Knife")) then
            return "Murderer"
        end
        if ch:FindFirstChild("Gun") or (pl.Backpack and pl.Backpack:FindFirstChild("Gun")) then
            return "Sheriff"
        end
    end
    return "Innocent"
end

local function getMurderer()
    for _, pl in ipairs(P:GetPlayers()) do
        if getRole(pl) == "Murderer" then
            return pl
        end
    end
    return nil
end

local function updESP()
    if not ES then
        for _, h in pairs(HL) do
            if h and h.Parent then pcall(function() h:Destroy() end) end
        end
        HL = {}
        return
    end
    for _, pl in ipairs(P:GetPlayers()) do
        if not (pl == lp) and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
            local role = getRole(pl)
            local col = Color3.fromRGB(40, 255, 80)
            if role == "Murderer" then
                col = Color3.fromRGB(255, 40, 40)
            elseif role == "Sheriff" or role == "Hero" then
                col = Color3.fromRGB(40, 120, 255)
            end
            local h = HL[pl]
            if not h or not h.Parent then
                h = Instance.new("Highlight")
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 0.4
                h.OutlineTransparency = 0.15
                h.Parent = pl.Character
                HL[pl] = h
            end
            h.FillColor = col
            h.OutlineColor = col
            h.Adornee = pl.Character
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.65)
        pcall(updESP)
    end
end)

