local coinRemote = RPS:FindFirstChild("Remotes")
if coinRemote then
    coinRemote = coinRemote:FindFirstChild("Gameplay")
    if coinRemote then coinRemote = coinRemote:FindFirstChild("CoinCollected") end
end
if coinRemote then
    coinRemote.OnClientEvent:Connect(function(_, cur, max)
        if typeof(cur) == "number" then realCoins = cur end
        if typeof(max) == "number" then realMax = max end
        if cur and max and cur >= max then
            markListedDone(lp.Name)
            print("[Done] Bag full:", lp.Name, cur, "/", max)
            tryFlingIfReady()
            task.wait(0.4)
            if RF and lp.Character then
                lp.Character:BreakJoints()
            end
        end
    end)
end

-- =========================================================
-- (FARM LOOP - SAFE MOVE + REAL COIN VERIFY)
-- =========================================================
task.spawn(function()
    local lastPrint = 0
    local lastClear = tick()
    local lastGuiRead = 0
    while true do
        if AF then
            local ping = getPing()
            if ping > 280 then
                if tick() - lastPrint > 3 then
                    lastPrint = tick()
                    print("[Farm] High ping paused")
                end
                task.wait(0.4)
            else
                local ch = lp.Character
                local root = ch and ch:FindFirstChild("HumanoidRootPart")
                local hum = ch and ch:FindFirstChild("Humanoid")
                if root and hum and hum.Health > 0 then
                    setNoclip(true)
                    hum.PlatformStand = false
                    root.Anchored = false

                    if tick() - lastClear > 30 then
                        VS = {}
                        lastClear = tick()
                        rebuildCoinCache()
                    end
                    if tick() - lastGuiRead > 2 then
                        lastGuiRead = tick()
                        readCoinGui()
                    end

                    if flinging then
                        task.wait(0.2)
                    else
                        local allCoins = getCoins()
                        local candidates = {}
                        for _, obj in ipairs(allCoins) do
                            local d = (obj.Position - root.Position).Magnitude
                            if d < RG then
                                table.insert(candidates, {part = obj, dist = d})
                            end
                        end

                        local target, dist = nil, math.huge
                        if #candidates > 0 then
                            table.sort(candidates, function(a, b) return a.dist < b.dist end)
                            if COIN_MODE == "Closest" then
                                target = candidates[1].part
                                dist = candidates[1].dist
                            else
                                local n = #candidates
                                if n <= 2 then
                                    local pick = candidates[math.random(1, n)]
                                    target, dist = pick.part, pick.dist
                                else
                                    local midStart = math.max(2, math.floor(n * 0.3))
                                    local midEnd = math.min(n - 1, math.ceil(n * 0.7))
                                    if midStart > midEnd then midStart, midEnd = 2, math.max(2, n - 1) end
                                    local idx = math.random(midStart, midEnd)
                                    target = candidates[idx].part
                                    dist = candidates[idx].dist
                                end
                            end
                        end

                        if tick() - lastPrint > 4 then
                            lastPrint = tick()
                            print("[Farm] Coins:", #allCoins, "| Bag:", realCoins, "/", realMax, "| Ping:", math.floor(ping))
                        end

                        if target and target.Parent then
                            local before = realCoins
                            local dest = target.Position + Vector3.new(0, 2, 0)
                            print("[Farm] -> coin", math.floor(dist), "studs | bag", realCoins)

                            -- Walk-speed lerp (safe) then force touch
                            safeMoveTo(root, dest, SP)
                            touchCoin(target, root)

                            -- Stay on coin briefly so server can count
                            local tWait = tick()
                            local got = false
                            while tick() - tWait < 0.9 do
                                if root and root.Parent and target and target.Parent then
                                    root.CFrame = CFrame.new(target.Position + Vector3.new(0, 2, 0))
                                    touchCoin(target, root)
                                end
                                if realCoins > before then got = true break end
                                if not target.Parent then got = true break end
                                if not (target:FindFirstChild("TouchInterest") or target:FindFirstChildWhichIsA("TouchTransmitter")) then
                                    got = true
                                    break
                                end
                                task.wait(0.08)
                            end

                            VS[target] = true
                            CL = CL + 1
                            if got and realCoins <= before then realCoins = before + 1 end
                            task.wait(got and COIN_DELAY or 0.15)
                        else
                            local n = rebuildCoinCache()
                            if tick() - lastPrint > 2 then
                                lastPrint = tick()
                                print("[Farm] Waiting for coins... found:", n, "| in round?")
                            end
                            task.wait(0.25)
                        end
                    end
                else
                    task.wait(0.25)
                end
            end
        else
            if not NOCLIP then setNoclip(false) end
            task.wait(0.4)
        end
    end
end)

RS.Stepped:Connect(function()
    if NOCLIP or AF then setNoclip(true) end
end)

lp.Idled:Connect(function()
    if AK then
        VU:Button2Down(Vector2.new(), workspace.CurrentCamera.CFrame)
        task.wait(1)
        VU:Button2Up(Vector2.new(), workspace.CurrentCamera.CFrame)
    end
end)

print("[mm2 coins farm] Loaded")
