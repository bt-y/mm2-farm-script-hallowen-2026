local hasTransfer = false

-- Auth
do
    if WL[lp.Name] then
        allowed = true
        hasTransfer = true
        print("[mm2 coins farm script 2026] Whitelisted - full access")
    else
        local sg = Instance.new("ScreenGui")
        sg.Name = "Auth"
        sg.ResetOnSpawn = false
        sg.Parent = pg

        local f = Instance.new("Frame")
        f.Size = UDim2.fromOffset(300, 160)
