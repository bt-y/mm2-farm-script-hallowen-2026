local PASS = "677skibidi"
local allowed = false

if WL[lp.Name] then
    allowed = true
    print("[Hub] Whitelisted")
else
    local sg = Instance.new("ScreenGui")
    sg.Name = "Auth"
    sg.ResetOnSpawn = false
    sg.Parent = pg

    local f = Instance.new("Frame")
    f.Size = UDim2.fromOffset(280, 140)
