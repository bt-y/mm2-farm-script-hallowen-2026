    if hum then hum.JumpPower = JP end
    if NOCLIP then setNoclip(true) end
end)

local coinRemote = RPS:FindFirstChild("Remotes")
if coinRemote then
    coinRemote = coinRemote:FindFirstChild("Gameplay")
    if coinRemote then coinRemote = coinRemote:FindFirstChild("CoinCollected") end
end
if coinRemote then
    coinRemote.OnClientEvent:Connect(function(_, cur, max)
        if cur >= max and RF and lp.Character then
            lp.Character:BreakJoints()
        end
    end)
end

task.spawn(function()
    while true do
        if AF then
            local ch = lp.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")
            local hum = ch and ch:FindFirstChild("Humanoid")
            if root and hum then
                if NOCLIP or AF then setNoclip(true) end
                hum.PlatformStand = false
                root.Anchored = false

                local murd = getMurderer()
                local murdRoot = murd and murd.Character and murd.Character:FindFirstChild("HumanoidRootPart")
local candidates = {}
for _, obj in ipairs(getCoins()) do
    local d = (obj.Position - root.Position).Magnitude
    if d < RG then
        if MODE == "Strategy" and murdRoot then
            if (obj.Position - murdRoot.Position).Magnitude >= 45 then
                table.insert(candidates, {part = obj, dist = d})
            end
        else
            table.insert(candidates, {part = obj, dist = d})
        end
    end
end

local closest = nil
local dist = math.huge

if #candidates > 0 then
    -- Sort by distance
    table.sort(candidates, function(a, b) return a.dist < b.dist end)

    -- Pick randomly from the closest 5 (so alts spread out)
    local pool = math.min(5, #candidates)
    local pick = candidates[math.random(1, pool)]
    closest = pick.part
    dist = pick.dist
end
RS.Stepped:Connect(function()
    if NOCLIP or AF then setNoclip(true) end
end)

lp.Idled:Connect(function()
    if AK then
        VU:Button2Down(Vector2.new(), workspace.CurrentCamera.CFrame)
        task.wait(1)
        VU:Button2Up(Vector2.new(), workspace.CurrentCamera.CFrame)
    end
end)

print("[mm2 coins farm] Loaded | " .. (isHidden and "HIDDEN" or "ORIGINAL"))
