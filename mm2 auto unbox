main.Position = UDim2.new(0.5, -130, 0.18, 0)
main.BackgroundColor3 = Color3.fromRGB(25, 12, 5)
main.Active = true
main.Draggable = true
main.Parent = gui
Instance.new("UICorner", main).CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -10, 0, 24)
title.Position = UDim2.new(0, 6, 0, 4)
title.BackgroundTransparency = 1
title.Text = "Halloween Box Unbox"
title.TextColor3 = Color3.fromRGB(255, 160, 60)
title.Font = Enum.Font.GothamBold
title.TextSize = 14
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = main

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -12, 0, 22)
status.Position = UDim2.new(0, 6, 0, 30)
status.BackgroundTransparency = 1
status.Text = OpenCrate and "Ready | Opened: 0" or "ERROR: OpenCrate not found"
status.TextColor3 = Color3.fromRGB(220, 200, 180)
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = main

local delayBox = Instance.new("TextBox")
delayBox.Size = UDim2.new(0.4, -6, 0, 26)
delayBox.Position = UDim2.new(0, 8, 0, 56)
delayBox.BackgroundColor3 = Color3.fromRGB(40, 20, 10)
delayBox.Text = "0.5"
delayBox.TextColor3 = Color3.new(1, 1, 1)
delayBox.Font = Enum.Font.GothamBold
delayBox.TextSize = 13
delayBox.Parent = main
Instance.new("UICorner", delayBox).CornerRadius = UDim.new(0, 5)
delayBox.FocusLost:Connect(function()
    local n = tonumber(delayBox.Text)
    if n and n >= 0.2 then DELAY = n else delayBox.Text = tostring(DELAY) end
end)

local startBtn = Instance.new("TextButton")
startBtn.Size = UDim2.new(0.55, -10, 0, 28)
startBtn.Position = UDim2.new(0.42, 0, 0, 55)
startBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 50)
startBtn.Text = "START"
startBtn.TextColor3 = Color3.new(1, 1, 1)
startBtn.Font = Enum.Font.GothamBold
startBtn.TextSize = 13
startBtn.Parent = main
Instance.new("UICorner", startBtn).CornerRadius = UDim.new(0, 6)

startBtn.MouseButton1Click:Connect(function()
    running = not running
    if running then
        startBtn.Text = "STOP"
        startBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
    else
        startBtn.Text = "START"
        startBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 50)
    end
    status.Text = (running and "Running" or "Stopped") .. " | Opened: " .. opened
end)

task.spawn(function()
    while true do
        if running then
            if openBox() then
                opened = opened + 1
            end
            task.wait(0.2)
            autoClaim()
            status.Text = "Running | Opened: " .. opened
            task.wait(DELAY)
        else
            autoClaim()
            task.wait(0.3)
        end
    end
end)

print("[Unbox] OpenCrate =", OpenCrate and OpenCrate:GetFullName() or "nil")
