-- MM2 Halloween Box Auto Unbox (separate script)
-- Opens the 2026 Halloween Box (~600 Candies / 1 Key) on a timer
-- Default delay: 0.5s

local Players = game:GetService("Players")
local RPS = game:GetService("ReplicatedStorage")
local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local DELAY = 0.5
local running = false
local opened = 0

-- Possible internal box names (game may use any of these)
local BOX_NAMES = {
    "Halloween Box 2026",
    "2026 Halloween Box",
    "HalloweenBox2026",
    "Halloween_Box_2026",
    "HalloweenBox",
    "Halloween Box",
    "Box2026",
    "Ember Box",
    "EmberBox",
}

local function findRemotes()
    local list = {}
    for _, v in ipairs(RPS:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            local n = string.lower(v.Name)
            if n:find("box") or n:find("unbox") or n:find("open")
                or n:find("shop") or n:find("buy") or n:find("crate")
                or n:find("case") or n:find("purchase") then
                table.insert(list, v)
            end
        end
    end
    return list
end

local function tryOpen(remote, boxName)
    if not remote then return false end
    local ok = false
    -- Common MM2-style argument patterns
    local patterns = {
        function() remote:FireServer(boxName) end,
        function() remote:FireServer("Buy", boxName) end,
        function() remote:FireServer("Unbox", boxName) end,
        function() remote:FireServer("Open", boxName) end,
        function() remote:FireServer("Purchase", boxName) end,
        function() remote:FireServer(boxName, "Candies") end,
        function() remote:FireServer(boxName, 1) end,
        function() remote:FireServer({Box = boxName}) end,
        function() remote:FireServer({Name = boxName}) end,
        function() remote:FireServer("Halloween") end,
        function() remote:InvokeServer(boxName) end,
        function() remote:InvokeServer("Buy", boxName) end,
        function() remote:InvokeServer("Unbox", boxName) end,
    }
    for _, fn in ipairs(patterns) do
        local success = pcall(fn)
        if success then ok = true end
    end
    return ok
end

local function doUnbox()
    local remotes = findRemotes()
    for _, boxName in ipairs(BOX_NAMES) do
        for _, r in ipairs(remotes) do
            tryOpen(r, boxName)
        end
    end
    -- Also try direct known paths if they exist
    pcall(function()
        local shop = RPS:FindFirstChild("Shop") or RPS:FindFirstChild("Remotes")
        if shop then
            local buy = shop:FindFirstChild("Buy") or shop:FindFirstChild("Purchase")
                or shop:FindFirstChild("Unbox") or shop:FindFirstChild("OpenBox")
            if buy then
                for _, boxName in ipairs(BOX_NAMES) do
                    tryOpen(buy, boxName)
                end
            end
        end
    end)
    opened = opened + 1
end

