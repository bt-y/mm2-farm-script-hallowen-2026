local delayBox = Instance.new("TextBox")
delayBox.Size = UDim2.new(0.45, -8, 0, 26)
delayBox.Position = UDim2.new(0, 8, 0, 72)
delayBox.BackgroundColor3 = Color3.fromRGB(40, 20, 10)
delayBox.Text = "0.5"
delayBox.TextColor3 = Color3.new(1, 1, 1)
delayBox.Font = Enum.Font.GothamBold
delayBox.TextSize = 13
