-- MM2 Halloween Box Auto Unbox v4 (clean, no hooks)
-- MUST rejoin before using if you ran the SPY version
-- OpenCrate:InvokeServer("Halloween2026Box", "MysteryBox", "Candies2026")

local Players = game:GetService("Players")
local RPS = game:GetService("ReplicatedStorage")
local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local DELAY = 1.0
local running = false
local opened = 0
local lastResult = "ready"

local function getOpenCrate()
    local ok, remote = pcall(function()
        return RPS.Remotes.Shop.OpenCrate
    end)
    if ok then return remote end
    return nil
end

local function openBox()
    local remote = getOpenCrate()
    if not remote then
        lastResult = "no remote"
        return false
    end
    local ok, result = pcall(function()
        return remote:InvokeServer("Halloween2026Box", "MysteryBox", "Candies2026")
    end)
    if not ok then
        lastResult = "error: " .. tostring(result)
        return false
    end
    if result == nil then
        lastResult = "nil (no candies / blocked)"
        return false
    end
    lastResult = typeof(result) == "table" and "ok (table)" or ("ok " .. tostring(result))
    return true
end

-- soft claim: only TextButtons with text Claim (no ImageButton Text)
local function autoClaim()
    for _, g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextButton") then
            local t = string.lower(g.Text or "")
            if (t == "claim" or t == "ok" or t == "continue") and g.Visible then
                pcall(function()
                    if getconnections then
                        for _, c in ipairs(getconnections(g.MouseButton1Click) or {}) do
                            pcall(function() c:Fire() end)
                        end
                        for _, c in ipairs(getconnections(g.Activated) or {}) do
                            pcall(function() c:Fire() end)
                        end
                    end
                    firesignal(g.MouseButton1Click)
                end)
            end
        end
    end
end

