-- MM2 Halloween Box Auto Unbox v2
-- 1) Press SPY then open ONE box manually -> captures the real remote
-- 2) Press START to repeat that call every Delay seconds
-- Also auto-clicks Claim / Open buttons

local Players = game:GetService("Players")
local RPS = game:GetService("ReplicatedStorage")
local VIM = game:GetService("VirtualInputManager")
local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local DELAY = 0.5
local running = false
local opened = 0
local spyOn = false

local captured = {
    remote = nil,
    args = nil,
    method = "FireServer",
}

local function deepCopy(t)
    if type(t) ~= "table" then return t end
    local n = {}
    for k, v in pairs(t) do n[k] = deepCopy(v) end
    return n
end

local function startSpy()
    if spyOn then return end
    spyOn = true

    if hookmetamethod and getnamecallmethod then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            if spyOn and (method == "FireServer" or method == "InvokeServer") then
                local path = ""
                pcall(function() path = self:GetFullName() end)
                local n = string.lower(tostring(self.Name or "") .. " " .. path)
                if n:find("box") or n:find("unbox") or n:find("shop") or n:find("buy")
                    or n:find("open") or n:find("crate") or n:find("case")
                    or n:find("purchase") or n:find("event") or n:find("halloween")
                    or n:find("candy") or n:find("reward") or n:find("remote") then
                    captured.remote = self
                    captured.args = deepCopy(args)
                    captured.method = method
                    print("[Unbox SPY]", method, path)
                    for i, a in ipairs(args) do
                        print("  arg"..i..":", typeof(a), a)
                    end
                end
            end
            return oldNamecall(self, ...)
        end)
        print("[Unbox] Spy hooked via metamethod")
        return
    end

    for _, v in ipairs(RPS:GetDescendants()) do
        if v:IsA("RemoteEvent") then
            local old = v.FireServer
            v.FireServer = function(self, ...)
                local args = {...}
                if spyOn then
                    captured.remote = self
                    captured.args = deepCopy(args)
                    captured.method = "FireServer"
                    print("[Unbox SPY] FireServer", self:GetFullName())
                    for i, a in ipairs(args) do print("  arg"..i, a) end
                end
                return old(self, ...)
            end
        elseif v:IsA("RemoteFunction") then
            local old = v.InvokeServer
            v.InvokeServer = function(self, ...)
                local args = {...}
                if spyOn then
                    captured.remote = self
                    captured.args = deepCopy(args)
                    captured.method = "InvokeServer"
                    print("[Unbox SPY] InvokeServer", self:GetFullName())
                    for i, a in ipairs(args) do print("  arg"..i, a) end
                end
                return old(self, ...)
            end
        end
    end
    print("[Unbox] Spy hooked via remote wrap")
end

local function fireCaptured()
    if not captured.remote or not captured.args then return false end
    local ok = pcall(function()
        if captured.method == "InvokeServer" then
            captured.remote:InvokeServer(table.unpack(captured.args))
        else
            captured.remote:FireServer(table.unpack(captured.args))
        end
    end)
    return ok
end

local function clickGuiButton(btn)
    if not btn or not btn:IsA("GuiButton") then return end
    pcall(function()
        if getconnections then
            for _, evName in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down"}) do
                local ok, conns = pcall(function() return getconnections(btn[evName]) end)
                if ok and conns then
                    for _, c in ipairs(conns) do
                        pcall(function() c:Fire() end)
                    end
                end
            end
        end
        local abs = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        local x = abs.X + size.X / 2
        local y = abs.Y + size.Y / 2
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function autoClickShopButtons()
    for _, g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextButton") or g:IsA("ImageButton") then
            local t = string.lower(tostring(g.Text or ""))
            local n = string.lower(tostring(g.Name or ""))
            if t == "claim" or t == "open" or t == "unbox" or t == "buy"
                or t:find("claim") or t:find("unbox") or t:find("open")
                or n:find("claim") or n:find("unbox") or n:find("open") then
                if g.Visible and g.AbsoluteSize.X > 5 then
                    clickGuiButton(g)
                end
            end
        end
    end
end

