status.Position = UDim2.new(0, 6, 0, 28)
status.BackgroundTransparency = 1
status.Text = "Rejoin first if you used SPY\nThen press START"
status.TextColor3 = Color3.fromRGB(220, 200, 180)
status.Font = Enum.Font.Gotham
status.TextSize = 12
status.TextXAlignment = Enum.TextXAlignment.Left
status.TextYAlignment = Enum.TextYAlignment.Top
status.Parent = main

local delayBox = Instance.new("TextBox")
delayBox.Size = UDim2.new(0.35, 0, 0, 26)
delayBox.Position = UDim2.new(0, 8, 0, 72)
delayBox.BackgroundColor3 = Color3.fromRGB(40, 20, 10)
delayBox.Text = "1.0"
delayBox.TextColor3 = Color3.new(1, 1, 1)
delayBox.Font = Enum.Font.GothamBold
delayBox.TextSize = 13
delayBox.Parent = main
Instance.new("UICorner", delayBox).CornerRadius = UDim.new(0, 5)
delayBox.FocusLost:Connect(function()
    local n = tonumber(delayBox.Text)
    if n and n >= 0.3 then DELAY = n else delayBox.Text = tostring(DELAY) end
end)

local startBtn = Instance.new("TextButton")
startBtn.Size = UDim2.new(0.55, -12, 0, 28)
startBtn.Position = UDim2.new(0.4, 0, 0, 71)
startBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 50)
startBtn.Text = "START"
startBtn.TextColor3 = Color3.new(1, 1, 1)
startBtn.Font = Enum.Font.GothamBold
startBtn.TextSize = 13
startBtn.Parent = main
Instance.new("UICorner", startBtn).CornerRadius = UDim.new(0, 6)

startBtn.MouseButton1Click:Connect(function()
    running = not running
    startBtn.Text = running and "STOP" or "START"
    startBtn.BackgroundColor3 = running and Color3.fromRGB(160, 40, 40) or Color3.fromRGB(40, 120, 50)
end)

local onceBtn = Instance.new("TextButton")
onceBtn.Size = UDim2.new(1, -16, 0, 26)
onceBtn.Position = UDim2.new(0, 8, 1, -34)
onceBtn.BackgroundColor3 = Color3.fromRGB(60, 80, 140)
onceBtn.Text = "Open 1 box now"
onceBtn.TextColor3 = Color3.new(1, 1, 1)
onceBtn.Font = Enum.Font.GothamBold
onceBtn.TextSize = 12
onceBtn.Parent = main
Instance.new("UICorner", onceBtn).CornerRadius = UDim.new(0, 6)
onceBtn.MouseButton1Click:Connect(function()
    if openBox() then opened = opened + 1 end
    task.wait(0.3)
    autoClaim()
    status.Text = "Opened: " .. opened .. "\n" .. lastResult
end)

task.spawn(function()
    while true do
        if running then
            if openBox() then opened = opened + 1 end
            task.wait(0.25)
            autoClaim()
            status.Text = "Running | " .. opened .. "\n" .. lastResult
            task.wait(DELAY)
        else
            task.wait(0.3)
        end
    end
end)

print("[Unbox v4] clean - no hooks. Rejoin if SPY was used before.")
