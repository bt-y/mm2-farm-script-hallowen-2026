local spyBtn = Instance.new("TextButton")
spyBtn.Size = UDim2.new(0.5, -10, 0, 30)
spyBtn.Position = UDim2.new(0.5, 2, 0, 70)
spyBtn.BackgroundColor3 = Color3.fromRGB(80, 60, 140)
spyBtn.Text = "SPY"
spyBtn.TextColor3 = Color3.new(1, 1, 1)
spyBtn.Font = Enum.Font.GothamBold
spyBtn.TextSize = 13
spyBtn.Parent = main
Instance.new("UICorner", spyBtn).CornerRadius = UDim.new(0, 6)

spyBtn.MouseButton1Click:Connect(function()
    startSpy()
    spyBtn.Text = "SPY ON"
    spyBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 160)
    status.Text = "SPY ON - open 1 box manually now"
end)

local startBtn = Instance.new("TextButton")
startBtn.Size = UDim2.new(1, -16, 0, 36)
startBtn.Position = UDim2.new(0, 8, 1, -48)
startBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 50)
startBtn.Text = "START"
startBtn.TextColor3 = Color3.new(1, 1, 1)
startBtn.Font = Enum.Font.GothamBold
startBtn.TextSize = 14
startBtn.Parent = main
Instance.new("UICorner", startBtn).CornerRadius = UDim.new(0, 6)

startBtn.MouseButton1Click:Connect(function()
    if not captured.remote then
        status.Text = "No remote captured!\nPress SPY then open 1 box first"
        return
    end
    running = not running
    if running then
        startBtn.Text = "STOP"
        startBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        status.Text = "Running | Opened: " .. opened
    else
        startBtn.Text = "START"
        startBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 50)
        status.Text = "Stopped | Opened: " .. opened
    end
end)

task.spawn(function()
    while true do
        if running then
            if fireCaptured() then
                opened = opened + 1
            end
            task.wait(0.15)
            autoClickShopButtons()
            local msg = "Running | Opened: " .. opened
            if captured.remote then
                msg = msg .. "\nRemote: " .. tostring(captured.remote.Name)
            end
            status.Text = msg
            task.wait(DELAY)
        else
            autoClickShopButtons()
            task.wait(0.25)
        end
    end
end)

print("[Unbox] Loaded. SPY -> open 1 box manually -> START")
