btn.MouseButton1Click:Connect(function()
    running = not running
    if running then
        btn.Text = "STOP"
        btn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        status.Text = "Running | Opened: " .. opened
    else
        btn.Text = "START"
        btn.BackgroundColor3 = Color3.fromRGB(40, 120, 50)
        status.Text = "Stopped | Opened: " .. opened
    end
end)

task.spawn(function()
    while true do
        if running then
            pcall(doUnbox)
            status.Text = "Running | Opened: " .. opened
            task.wait(DELAY)
        else
            task.wait(0.2)
        end
    end
end)
