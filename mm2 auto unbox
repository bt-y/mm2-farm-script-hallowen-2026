-- MM2 Halloween Box Auto Unbox v3 (fixed remote)
-- ReplicatedStorage.Remotes.Shop.OpenCrate:InvokeServer("Halloween2026Box", "MysteryBox", "Candies2026")

local Players = game:GetService("Players")
local RPS = game:GetService("ReplicatedStorage")
local VIM = game:GetService("VirtualInputManager")
local lp = Players.LocalPlayer
local pg = lp:WaitForChild("PlayerGui")

local DELAY = 0.5
local running = false
local opened = 0

local OpenCrate = nil
pcall(function()
    OpenCrate = RPS:WaitForChild("Remotes", 5)
        :WaitForChild("Shop", 5)
        :WaitForChild("OpenCrate", 5)
end)

local function openBox()
    if not OpenCrate then
        pcall(function()
            OpenCrate = RPS.Remotes.Shop.OpenCrate
        end)
    end
    if not OpenCrate then return false end
    local ok = pcall(function()
        OpenCrate:InvokeServer("Halloween2026Box", "MysteryBox", "Candies2026")
    end)
    return ok
end

local function clickGuiButton(btn)
    if not btn or not btn:IsA("GuiButton") then return end
    pcall(function()
        if getconnections then
            for _, evName in ipairs({"Activated", "MouseButton1Click", "MouseButton1Down"}) do
                local ok, conns = pcall(function() return getconnections(btn[evName]) end)
                if ok and conns then
                    for _, c in ipairs(conns) do
                        pcall(function() c:Fire() end)
                    end
                end
            end
        end
        local abs = btn.AbsolutePosition
        local size = btn.AbsoluteSize
        if size.X < 5 or size.Y < 5 then return end
        local x = abs.X + size.X / 2
        local y = abs.Y + size.Y / 2
        VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.02)
        VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
end

local function autoClaim()
    for _, g in ipairs(pg:GetDescendants()) do
        if g:IsA("TextButton") or g:IsA("ImageButton") then
            local t = ""
            pcall(function() t = string.lower(tostring(g.Text or "")) end)
            local n = string.lower(tostring(g.Name or ""))
            if t == "claim" or t:find("claim") or n:find("claim")
                or t == "open" or t == "ok" or t == "continue" then
                local vis = false
                pcall(function() vis = g.Visible and g.AbsoluteSize.X > 5 end)
                if vis then clickGuiButton(g) end
            end
        end
    end
end

-- GUI
